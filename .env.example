# ──────────────────────────────────────────────────────────────────────────────# Environment Variables Template
# Copy this file to .env.local (for local dev) or configure in Cloudflare Workers# dashboard (for production).
#
# IMPORTANT:
#   - Never commit .env or .env.local to version control.
#   - NEXT_PUBLIC_ prefixed variables are exposed to the client bundle.
#   - All other variables are server-only and must NEVER appear in client code.
#   - For Cloudflare Workers, set secrets via: npx wrangler secret put <NAME>
# ──────────────────────────────────────────────────────────────────────────────# Node Environment
NODE_ENV=production# Host Configuration
PUBLIC_HOST=markdevelopers.in
ADMIN_HOST_PREFIX=admindashboard.
PUBLIC_HOST_DEV=localhost:3000
ADMIN_HOST_PREFIX_DEV=admin.# ──────────────────────────────────────────────────────────────────────────────
# Firebase Client SDK (PUBLIC — safe to expose in client bundle)
# These are not secrets — they are the Firebase web app config.
# ──────────────────────────────────────────────────────────────────────────────NEXT_PUBLIC_FIREBASE_API_KEY=your_api_key
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=your_project.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=your_project_id
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=your_project.firebasestorage.app
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=your_sender_id
NEXT_PUBLIC_FIREBASE_APP_ID=your_app_id
NEXT_PUBLIC_FIREBASE_MEASUREMENT_ID=G-XXXXXXXXXX# ──────────────────────────────────────────────────────────────────────────────
# Cloudinary (SECRET — never expose to client)
# Get these from: https://cloudinary.com/console
# ──────────────────────────────────────────────────────────────────────────────CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret# ──────────────────────────────────────────────────────────────────────────────
# Firebase Admin SDK (SECRET — never expose to client)
# Get from: Firebase Console → Project Settings → Service Accounts
# ──────────────────────────────────────────────────────────────────────────────FIREBASE_CLIENT_EMAIL=firebase-adminsdk-xxxxx@your_project.iam.gserviceaccount.com
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nYOUR_KEY_HERE\n-----END PRIVATE KEY-----\n"# ──────────────────────────────────────────────────────────────────────────────
# Resend (SECRET — email service)
# Get from: https://resend.com/api-keys
# ──────────────────────────────────────────────────────────────────────────────RESEND_API_KEY=re_your_api_key# ──────────────────────────────────────────────────────────────────────────────
# Cloudflare (SECRET — only needed for Workers deployment scripts)
# Get from: Cloudflare Dashboard → My Profile → API Tokens
# ──────────────────────────────────────────────────────────────────────────────CLOUDFLARE_API_SECRET=your_api_secret
CLOUDFLARE_ACCOUNT_ID=your_account_id
CLOUDFLARE_API_TOKEN=your_api_token# ──────────────────────────────────────────────────────────────────────────────
# Session Secret (SECRET — used to sign session JWTs)
# Generate with: openssl rand -hex 32
# This MUST be at least 256 bits (64 hex characters) and kept secret.
# ──────────────────────────────────────────────────────────────────────────────SESSION_SECRET=generate_with_openssl_rand_hex_32# ──────────────────────────────────────────────────────────────────────────────
# Cloudflare Turnstile (CAPTCHA — protects contact form from spam)
# Get from: Cloudflare Dashboard → Turnstile → Create Site
# NEXT_PUBLIC_ prefix is required — the site key is used in the browser.
# The secret key must NEVER be exposed to the client.
# ──────────────────────────────────────────────────────────────────────────────NEXT_PUBLIC_TURNSTILE_SITE_KEY=your_turnstile_site_key
TURNSTILE_SECRET_KEY=your_turnstile_secret_key
