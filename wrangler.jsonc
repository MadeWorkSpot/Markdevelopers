{
	"$schema": "node_modules/wrangler/config-schema.json",
	"main": ".open-next/worker.js",
	"name": "markdev",
	"compatibility_date": "2025-04-01",
	"compatibility_flags": [
		"nodejs_compat",
		"global_fetch_strictly_public"
	],
	"assets": {
		"directory": ".open-next/assets",
		"binding": "ASSETS"
	},
	"services": [
		{
			"binding": "WORKER_SELF_REFERENCE",
			"service": "markdev"
		}
	],
	"kv_namespaces": [
		{
			"binding": "RATE_LIMIT_KV",
			// Replace with your KV namespace ID after running:
			//   npx wrangler kv namespace create RATE_LIMIT_KV
			"id": "81791a6b6e2c4d2f80a0fcd7e0d69bcf",
			"remote": true
		}
	],
	"vars": {
		"CLOUDINARY_CLOUD_NAME": "dtr9ws0x",
		"CLOUDINARY_API_KEY": "161842465146681"
	},
	"images": {
		"binding": "IMAGES"
	},
	"observability": {
		"enabled": true,
		"logs": {
			"enabled": true,
			"persist": true,
			"invocation_logs": true
		}
	},
	"env": {
		"staging": {
			"name": "markdev-staging",
			"services": [
				{
					"binding": "WORKER_SELF_REFERENCE",
					"service": "markdev-staging"
				}
			],
			"kv_namespaces": [
				{
					"binding": "RATE_LIMIT_KV",
					// Staging KV namespace (created with `wrangler kv namespace create RATE_LIMIT_KV_STAGING`)
					"id": "ea6d8200e1654cfba33b65878794b40f",
					"remote": true
				}
			],
			"vars": {
				"PUBLIC_HOST": "dev.markdevelopers.in",
				"ADMIN_HOST_PREFIX": "admin-dev.",
				"ENVIRONMENT": "staging",
				"CLOUDINARY_CLOUD_NAME": "dtr9ws0x",
				"CLOUDINARY_API_KEY": "161842465146681"
			},
			"images": {
				"binding": "IMAGES"
			}
		}
	}
}
