{
  "$schema": "node_modules/wrangler/config-schema.json",
  "main": ".open-next/worker.js",
  "name": "admin",
  "compatibility_date": "2025-04-01",
  "compatibility_flags": [
    "nodejs_compat",
    "global_fetch_strictly_public"
  ],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "services": [
    {
      "binding": "WORKER_SELF_REFERENCE",
      "service": "admin"
    }
  ],
  "kv_namespaces": [
    {
      "binding": "RATE_LIMIT_KV",
      "id": "81791a6b6e2c4d2f80a0fcd7e0d69bcf"
    }
  ],
  "vars": {
    "CLOUDINARY_CLOUD_NAME": "dtr9ws0x",
    "CLOUDINARY_API_KEY": "161842465146681"
  },
  "images": {
    "binding": "IMAGES"
  },
  "observability": {
    "enabled": true,
    "logs": {
      "enabled": true,
      "persist": true,
      "invocation_logs": true
    }
  },
  "env": {
    "staging": {
      "name": "admin-staging",
      "services": [
        {
          "binding": "WORKER_SELF_REFERENCE",
          "service": "admin-staging"
        }
      ],
      "kv_namespaces": [
        {
          "binding": "RATE_LIMIT_KV",
          "id": "ea6d8200e1654cfba33b65878794b40f"
        }
      ],
      "vars": {
        "PUBLIC_HOST": "dev.markdevelopers.in",
        "ADMIN_HOST_PREFIX": "admin-dev.",
        "ADMIN_HOST": "admin-dev.markdevelopers.in",
        "ENVIRONMENT": "staging"
      },
      "images": {
        "binding": "IMAGES"
      }
    }
  }
}
